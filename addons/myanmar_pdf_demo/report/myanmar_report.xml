<odoo>
  <template id="report_myanmar"><t t-call="web.html_container">
    <t t-foreach="docs" t-as="o"><t t-call="web.external_layout">
      <style>.myanmar-demo { font-family: 'Noto Sans Myanmar'; font-size: 18px; line-height: 1.9; }</style>
      <div class="page myanmar-demo">
        <h2>Myanmar Unicode · Odoo 20</h2>
        <p t-out="o.name"/>
        <table class="table table-sm"><thead><tr><th>Demo invoice</th><th>Original Unicode</th></tr></thead>
          <tbody><tr><td>INV/DEMO/0001</td><td t-out="o.name"/></tr></tbody></table>
        <div style="page-break-before: always"><h3>Page 2 · Searchable Myanmar text</h3><p t-out="o.name"/></div>
      </div>
    </t></t>
  </t></template>
  <record id="action_report_myanmar" model="ir.actions.report">
    <field name="name">Myanmar Unicode Demo</field>
    <field name="model">res.partner</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">myanmar_pdf_demo.report_myanmar</field>
    <field name="binding_model_id" ref="base.model_res_partner"/>
    <field name="binding_type">report</field>
  </record>
</odoo>
